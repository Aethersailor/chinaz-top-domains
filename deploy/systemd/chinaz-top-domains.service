[Unit]
Description=Generate ChinaZ top-domain snapshots
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=chinaz-domains
Group=chinaz-domains
WorkingDirectory=/var/lib/chinaz-top-domains
Environment=HOME=/var/lib/chinaz-top-domains
EnvironmentFile=/etc/default/chinaz-top-domains
ExecStart=/opt/chinaz-top-domains/run-and-publish.sh
TimeoutStartSec=6h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/chinaz-top-domains /var/lib/chinaz-top-domains
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
